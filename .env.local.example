# Copy this file to .env.local and fill with your Supabase project values.

# Deployed — set these wherever the app is hosted.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# The only two people who may use this app. Comma-separated, compared
# case-insensitively. Required at runtime — if unset, everyone is denied.
ALLOWED_USER_EMAILS=one@example.com,two@example.com

# Used only by `npm run seed` to create the two accounts above in Supabase
# auth. Do NOT set these in your hosting provider's environment — they are
# plaintext passwords and the deployed app never reads them. Quote any
# password containing # or spaces.
SEED_USER_1_EMAIL=one@example.com
SEED_USER_1_PASSWORD="change-me-please"
SEED_USER_2_EMAIL=two@example.com
SEED_USER_2_PASSWORD="change-me-too"
